NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
NEXT_PUBLIC_SITE_URL=https://sloe.my.id
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
OPENROUTER_API_KEY=sk-or-...
GEMINI_API_KEY=AIza...

# --- Supabase (server-only) ---
# Webhook Paddle/Midtrans dan penulisan tabel `passes`.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# --- Situs ---
NEXT_PUBLIC_APP_URL=https://sloe.my.id

# --- Email ---
RESEND_API_KEY=re_...
FEEDBACK_FROM_EMAIL=Sloe <hello@sloe.my.id>
FEEDBACK_TO_EMAIL=support@sloe.my.id

# --- Midtrans (pembayaran Indonesia: QRIS + e-wallet) ---
# MIDTRANS_IS_PRODUCTION harus cocok dengan kunci: true + Mid-server-… (live),
# false + SB-Mid-server-… (sandbox). Kunci sandbox dipakai Snap sandbox, dan
# notifikasi sandbox ditandatangani dengan kunci sandbox.
MIDTRANS_SERVER_KEY=SB-Mid-server-...
MIDTRANS_IS_PRODUCTION=false
# Selama akun masih ditinjau: notifikasi sandbox ditandatangani kunci sandbox,
# notifikasi live dengan kunci live. Isi dua-duanya supaya webhook menerima
# keduanya. Matikan (atau hapus) begitu live sudah jalan penuh.
MIDTRANS_ALLOW_SANDBOX_WEBHOOK=false
MIDTRANS_SANDBOX_SERVER_KEY=SB-Mid-server-...

# --- Polar (pembayaran internasional, USD) ---
# Polar adalah Merchant of Record: ia yang menagih pajak, menerbitkan struk, dan
# menangani pengembalian dana. Sandbox dan produksi terpisah, tokennya berbeda.
# Hapus/isi "sandbox" hanya saat menguji; untuk live biarkan produksi.
POLAR_ENVIRONMENT=production
# Organization Access Token (prefix `polar_oat_`), server-only. Buat di
# dashboard Polar: Settings -> Access Tokens. Scope: products:read,
# checkouts:write, orders:read, webhooks:read.
POLAR_ACCESS_TOKEN=polar_oat_...
# ID produk yang sudah dibuat di Polar (bukan price id). Satu per paket.
POLAR_PRODUCT_PLUS=...
POLAR_PRODUCT_PRO=...
POLAR_PRODUCT_TOPUP=...
# Kunci penanda tangan notifikasi (prefix `whsec_`) dari webhook endpoint
# https://sloe.my.id/api/polar/webhook (server-only).
POLAR_WEBHOOK_SECRET=whsec_...
